<Application x:Class="PhotoFrame.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <!-- ========== ДЕРЕВЯННАЯ РАМКА ========== -->
        <Style x:Key="FrameWood" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.55" Color="#3B2507" Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== МЕТАЛЛИЧЕСКАЯ РАМКА ========== -->
        <Style x:Key="FrameMetal" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="5" Opacity="0.5" Color="Black" Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== СОВРЕМЕННАЯ РАМКА ========== -->
        <Style x:Key="FrameModern" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="10" Opacity="0.6" Color="Black" Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== КЛАССИЧЕСКАЯ (золочёная) ========== -->
        <Style x:Key="FrameMinimal" TargetType="Border">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.5" Color="#2A1F0A" Direction="315"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
